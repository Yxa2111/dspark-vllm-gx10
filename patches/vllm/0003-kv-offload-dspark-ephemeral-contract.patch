index 2e0126368..443ddbdd2 100644
--- a/vllm/config/speculative.py
+++ b/vllm/config/speculative.py
@@ -1247,6 +1247,19 @@ class SpeculativeConfig:
     def use_dspark(self) -> bool:
         return self.method == "dspark"

+    def has_ephemeral_draft_context(self) -> bool:
+        """Whether the draft KV is rebuilt from target hidden states.
+
+        Unlike EAGLE/EAGLE3/MTP, DSpark's draft context is per-round scratch
+        state and has no request-independent prefix-cache meaning. A miss in
+        that group therefore cannot authoritatively veto stable target-model
+        groups during multi-group cache-hit convergence.
+
+        DFlash has a similar architecture but is intentionally excluded until
+        it has independent end-to-end coverage on this runtime.
+        """
+        return self.method == "dspark"
+
     def uses_dynamic_speculative_decoding(self) -> bool:
         return self.num_speculative_tokens_per_batch_size is not None

