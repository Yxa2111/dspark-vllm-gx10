index 000000000..641e854bd
--- /dev/null
+++ b/vllm/v1/kv_offload/cpu/distributed_staging.py
@@ -0,0 +1,159 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Bounded cross-node relay for rank-zero CPU KV staging."""
+
+from collections.abc import Iterator, Sequence
+
+import numpy as np
+import torch
+import torch.distributed as dist
+from torch.distributed import ProcessGroup
+
+
+class RankZeroStagingRelay:
+    """Move per-rank CPU KV rows to and from rank zero.
+
+    Every rank owns ``local_tensors``. Rank zero additionally maps one tensor
+    list per remote rank into the scheduler-visible shared region. Transfers
+    are synchronous and bounded by ``max_chunk_bytes``; callers keep GPU DMA
+    asynchronous around this relay.
+    """
+
+    def __init__(
+        self,
+        local_tensors: list[torch.Tensor],
+        remote_tensors: dict[int, list[torch.Tensor]],
+        rank: int,
+        ranks: Sequence[int],
+        cpu_group: ProcessGroup,
+        max_chunk_bytes: int,
+    ) -> None:
+        if max_chunk_bytes <= 0:
+            raise ValueError("max_chunk_bytes must be positive")
+        if not ranks or ranks[0] != 0:
+            raise ValueError("rank-zero staging requires global rank 0 as owner")
+        if rank not in ranks:
+            raise ValueError(f"rank {rank} is not part of relay ranks {list(ranks)}")
+        if rank == 0 and set(remote_tensors) != set(ranks[1:]):
+            raise ValueError("rank zero must map every remote rank")
+        if rank != 0 and remote_tensors:
+            raise ValueError("non-owner ranks cannot map remote staging tensors")
+
+        self.local_tensors = local_tensors
+        self.remote_tensors = remote_tensors
+        self.rank = rank
+        self.ranks = list(ranks)
+        self.cpu_group = cpu_group
+        self.max_chunk_bytes = max_chunk_bytes
+        self.max_observed_payload_bytes = 0
+
+        for tensor in local_tensors:
+            self._validate_tensor(tensor)
+        for tensors in remote_tensors.values():
+            if len(tensors) != len(local_tensors):
+                raise ValueError("remote and local tensor counts differ")
+            for local, remote in zip(local_tensors, tensors):
+                self._validate_tensor(remote)
+                if remote.shape != local.shape:
+                    raise ValueError("remote and local staging shapes differ")
+
+    @staticmethod
+    def _validate_tensor(tensor: torch.Tensor) -> None:
+        if tensor.device.type != "cpu" or tensor.dtype != torch.int8:
+            raise ValueError("staging tensors must be CPU int8 tensors")
+        if tensor.ndim != 2:
+            raise ValueError("staging tensors must have shape (blocks, bytes)")
+
+    def all_ranks_ready(self, ready: bool) -> bool:
+        """Return true only when every relay rank reports a ready DMA job."""
+        flag = torch.tensor([int(ready)], dtype=torch.int32)
+        dist.all_reduce(flag, op=dist.ReduceOp.MIN, group=self.cpu_group)
+        return bool(flag.item())
+
+    def stage_store(self, job_id: int, block_ids: np.ndarray) -> int:
+        """Gather remote-rank rows into rank zero's shared region."""
+        return self._exchange(job_id, block_ids, store=True)
+
+    def stage_load(self, job_id: int, block_ids: np.ndarray) -> int:
+        """Scatter rank zero's shared rows into remote-rank local staging."""
+        return self._exchange(job_id, block_ids, store=False)
+
+    def _exchange(self, job_id: int, block_ids: np.ndarray, store: bool) -> int:
+        if block_ids.ndim != 1:
+            raise ValueError("block_ids must be one-dimensional")
+        if not len(block_ids) or len(self.ranks) == 1:
+            return 0
+
+        total_bytes = 0
+        tag = int(job_id % 2_147_483_647)
+        for peer_global_rank in self.ranks[1:]:
+            if self.rank not in (0, peer_global_rank):
+                continue
+
+            remote_views = self.remote_tensors.get(peer_global_rank)
+            for tensor_idx, local_tensor in enumerate(self.local_tensors):
+                owner_tensor = (
+                    remote_views[tensor_idx]
+                    if self.rank == 0 and remote_views is not None
+                    else local_tensor
+                )
+                for index in self._iter_indices(block_ids, local_tensor.shape[1]):
+                    payload_shape = (len(index), local_tensor.shape[1])
+                    payload_bytes = payload_shape[0] * payload_shape[1]
+                    self.max_observed_payload_bytes = max(
+                        self.max_observed_payload_bytes, payload_bytes
+                    )
+                    total_bytes += payload_bytes
+
+                    if store:
+                        if self.rank == peer_global_rank:
+                            payload = local_tensor.index_select(0, index).contiguous()
+                            dist.send(
+                                payload,
+                                dst=self.ranks[0],
+                                group=self.cpu_group,
+                                tag=tag,
+                            )
+                        else:
+                            payload = torch.empty(payload_shape, dtype=torch.int8)
+                            dist.recv(
+                                payload,
+                                src=peer_global_rank,
+                                group=self.cpu_group,
+                                tag=tag,
+                            )
+                            owner_tensor.index_copy_(0, index, payload)
+                    elif self.rank == 0:
+                        payload = owner_tensor.index_select(0, index).contiguous()
+                        dist.send(
+                            payload,
+                            dst=peer_global_rank,
+                            group=self.cpu_group,
+                            tag=tag,
+                        )
+                    else:
+                        payload = torch.empty(payload_shape, dtype=torch.int8)
+                        dist.recv(
+                            payload,
+                            src=self.ranks[0],
+                            group=self.cpu_group,
+                            tag=tag,
+                        )
+                        local_tensor.index_copy_(0, index, payload)
+        return total_bytes
+
+    def _iter_indices(
+        self, block_ids: np.ndarray, page_size: int
+    ) -> Iterator[torch.Tensor]:
+        blocks_per_chunk = max(1, self.max_chunk_bytes // page_size)
+        for start in range(0, len(block_ids), blocks_per_chunk):
+            chunk = np.array(
+                block_ids[start : start + blocks_per_chunk],
+                dtype=np.int64,
+                copy=True,
+            )
+            yield torch.from_numpy(chunk)
+
+    def shutdown(self) -> None:
+        self.remote_tensors.clear()
+        self.local_tensors = []
