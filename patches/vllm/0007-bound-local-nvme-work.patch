+def test_full_io_queue_fails_closed_after_bounded_wait() -> None:
+    backend = DiskBackend()
+    backend._store_queue = queue.Queue(maxsize=1)
+    backend._enqueue_timeout_s = 0.001
+    backend._store_queue.put_nowait(object())
+
+    with pytest.raises(RuntimeError, match="store queue remained full.*depth=1"):
+        backend.launch_copy(
+            [1],
+            [2],
+            is_store=True,
+            event_idx=3,
+            events_list=[],
+        )
+
+
+def test_shutdown_replaces_queued_work_with_one_sentinel() -> None:
+    backend = DiskBackend()
+    backend._store_queue = queue.Queue(maxsize=2)
+    backend._load_queue = queue.Queue(maxsize=2)
+    backend._store_queue.put_nowait(object())
+    backend._load_queue.put_nowait(object())
+
+    backend.shutdown()
+
+    assert backend._store_queue.get_nowait() is None
+    assert backend._load_queue.get_nowait() is None
+    with pytest.raises(queue.Empty):
+        backend._store_queue.get_nowait()
+    with pytest.raises(RuntimeError, match="backend is shut down"):
+        backend.launch_copy([1], [2], True, 3, [])
