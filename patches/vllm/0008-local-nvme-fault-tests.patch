+def test_preallocation_enospc_closes_and_unlinks(
+    tmp_path, monkeypatch
+) -> None:
+    monkeypatch.setattr(disk_backend_module, "pin_tensor", lambda _tensor: None)
+    monkeypatch.setattr(
+        disk_backend_module,
+        "build_params",
+        lambda *_args, **_kwargs: object(),
+    )
+
+    def fail_fallocate(_fd: int, _offset: int, _length: int) -> None:
+        raise OSError(errno.ENOSPC, "simulated no space")
+
+    monkeypatch.setattr(os, "posix_fallocate", fail_fallocate)
+    backend = DiskBackend()
+    path = tmp_path / "preallocate-failure.slots"
+    gpu_caches = {"kv": torch.zeros((2, 4096), dtype=torch.int8)}
+
+    with pytest.raises(OSError) as error:
+        backend.init(
+            gpu_caches,
+            torch.device("cpu"),
+            SimpleNamespace(cuda_stream=1),
+            SimpleNamespace(cuda_stream=2),
+            str(path),
+            num_disk_slots=2,
+            total_block_bytes=4096,
+            use_page_cache=True,
+            preallocate_disk=True,
+        )
+
+    assert error.value.errno == errno.ENOSPC
+    assert backend._fd == -1
+    assert not path.exists()
+    assert backend._store_thread is None
+    assert backend._load_thread is None
+
+
 def test_batch_copy_uses_independent_row_strides(monkeypatch) -> None:
