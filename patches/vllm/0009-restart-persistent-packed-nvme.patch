index 000000000..2f9fc30dc
--- /dev/null
+++ b/tests/v1/simple_kv_offload/test_persistent_metadata.py
@@ -0,0 +1,233 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from __future__ import annotations
+
+import os
+
+import pytest
+
+from vllm.v1.simple_kv_offload.persistent_metadata import (
+    RankSlotManifest,
+    SchedulerSlotIndex,
+)
+
+
+def _identity(**overrides: object) -> dict[str, object]:
+    identity: dict[str, object] = {
+        "cache_identity": "dsv4-0731-test",
+        "payload_bytes": 1065792,
+        "rank": 0,
+        "slot_bytes": 1069056,
+        "world_size": 2,
+    }
+    identity.update(overrides)
+    return identity
+
+
+def test_rank_manifest_reopens_checksums_and_invalidations(tmp_path) -> None:
+    path = tmp_path / "slots.rank_0.meta"
+    manifest = RankSlotManifest(str(path), 4, _identity())
+    manifest.commit({1: 0x12345678, 3: 0xAABBCCDD})
+    manifest.invalidate([3])
+    manifest.close()
+
+    reopened = RankSlotManifest(str(path), 4, _identity())
+    assert reopened.load() == [None, 0x12345678, None, None]
+    reopened.close()
+    assert path.stat().st_mode & 0o777 == 0o600
+
+
+def test_scheduler_index_reopens_raw_hashes_and_invalidations(tmp_path) -> None:
+    path = tmp_path / "slots.index"
+    index = SchedulerSlotIndex(str(path), 4, _identity(rank="scheduler"))
+    index.commit({1: b"a" * 36, 2: b"b" * 12})
+    index.invalidate([2])
+    index.close()
+
+    reopened = SchedulerSlotIndex(str(path), 4, _identity(rank="scheduler"))
+    assert reopened.load() == {1: b"a" * 36}
+    reopened.close()
+
+
+@pytest.mark.parametrize(
+    "changed",
+    [
+        {"cache_identity": "another-model"},
+        {"payload_bytes": 1},
+        {"rank": 1},
+        {"slot_bytes": 4096},
+        {"world_size": 1},
+    ],
+)
+def test_identity_or_geometry_mismatch_is_rejected(tmp_path, changed) -> None:
+    path = tmp_path / "slots.rank_0.meta"
+    RankSlotManifest(str(path), 4, _identity()).close()
+
+    with pytest.raises(ValueError, match="identity mismatch"):
+        RankSlotManifest(str(path), 4, _identity(**changed))
+
+
+def test_wrong_size_and_symlink_are_rejected(tmp_path) -> None:
+    path = tmp_path / "slots.index"
+    SchedulerSlotIndex(str(path), 4, _identity()).close()
+    with path.open("ab") as stream:
+        stream.write(b"extra")
+
+    with pytest.raises(ValueError, match="size mismatch"):
+        SchedulerSlotIndex(str(path), 4, _identity())
+
+    target = tmp_path / "target"
+    target.write_bytes(b"")
+    target.chmod(0o600)
+    link = tmp_path / "link"
+    link.symlink_to(target)
+    with pytest.raises(OSError):
+        RankSlotManifest(str(link), 4, _identity())
+
+
+@pytest.mark.parametrize("kind", ["rank", "index"])
+def test_header_and_record_corruption_are_rejected(tmp_path, kind) -> None:
+    path = tmp_path / kind
+    if kind == "rank":
+        metadata = RankSlotManifest(str(path), 4, _identity())
+        metadata.commit({1: 0x12345678})
+    else:
+        metadata = SchedulerSlotIndex(str(path), 4, _identity())
+        metadata.commit({1: b"h" * 36})
+    record_size = metadata.record_size
+    metadata.close()
+
+    fd = os.open(path, os.O_RDWR)
+    try:
+        byte = os.pread(fd, 1, 4096 + record_size)
+        os.pwrite(fd, bytes([byte[0] ^ 0x80]), 4096 + record_size)
+    finally:
+        os.close(fd)
+
+    reopened = (
+        RankSlotManifest(str(path), 4, _identity())
+        if kind == "rank"
+        else SchedulerSlotIndex(str(path), 4, _identity())
+    )
+    with pytest.raises(ValueError, match="corrupt persistent"):
+        reopened.load()
+    reopened.close()
+
+    fd = os.open(path, os.O_RDWR)
+    try:
+        byte = os.pread(fd, 1, 64)
+        os.pwrite(fd, bytes([byte[0] ^ 1]), 64)
+    finally:
+        os.close(fd)
+    with pytest.raises(ValueError, match="identity mismatch"):
+        if kind == "rank":
+            RankSlotManifest(str(path), 4, _identity())
+        else:
+            SchedulerSlotIndex(str(path), 4, _identity())
+
+
+def test_hash_length_and_slot_bounds_fail_closed(tmp_path) -> None:
+    index = SchedulerSlotIndex(str(tmp_path / "index"), 2, _identity())
+    with pytest.raises(ValueError, match="block hash length"):
+        index.commit({1: b"x" * 81})
+    with pytest.raises(IndexError, match="slot out of range"):
+        index.invalidate([2])
+    index.close()
+
+
+def test_clear_durably_invalidates_every_slot(tmp_path) -> None:
+    path = tmp_path / "index"
+    index = SchedulerSlotIndex(str(path), 3, _identity())
+    index.commit({1: b"a" * 36, 2: b"b" * 36})
+    index.clear()
+    index.close()
+
+    reopened = SchedulerSlotIndex(str(path), 3, _identity())
+    assert reopened.load() == {}
+    reopened.close()
+
+
+def test_six_step_commit_protocol_publishes_only_after_rank_durability(
+    tmp_path,
+) -> None:
+    index_path = tmp_path / "cache.index"
+    rank0_path = tmp_path / "cache.rank_0.meta"
+    rank1_path = tmp_path / "cache.rank_1.meta"
+    index_identity = _identity(rank="scheduler")
+    rank0 = RankSlotManifest(str(rank0_path), 3, _identity(rank=0))
+    rank1 = RankSlotManifest(str(rank1_path), 3, _identity(rank=1))
+    index = SchedulerSlotIndex(str(index_path), 3, index_identity)
+
+    old_hash = b"o" * 36
+    index.commit({1: old_hash})
+    rank0.commit({1: 10})
+    rank1.commit({1: 20})
+
+    # Step 1: scheduler invalidates before either worker may overwrite data.
+    index.invalidate([1])
+    index.close()
+    index = SchedulerSlotIndex(str(index_path), 3, index_identity)
+    assert index.load() == {}
+
+    # Steps 2 and 3: rank validity is cleared before packed rows are written.
+    rank0.invalidate([1])
+    rank1.invalidate([1])
+    assert rank0.load()[1] is None
+    assert rank1.load()[1] is None
+    assert index.load() == {}
+
+    # Steps 4 and 5: both durable rank records still do not publish the hash.
+    rank0.commit({1: 30})
+    rank1.commit({1: 40})
+    assert rank0.load()[1] == 30
+    assert rank1.load()[1] == 40
+    assert index.load() == {}
+
+    # Step 6 is the sole durable visibility point.
+    new_hash = b"n" * 36
+    index.commit({1: new_hash})
+    index.close()
+    reopened = SchedulerSlotIndex(str(index_path), 3, index_identity)
+    assert reopened.load() == {1: new_hash}
+    reopened.close()
+    rank0.close()
+    rank1.close()
+
+
+def test_short_metadata_io_is_completed_and_sync_failure_propagates(
+    tmp_path, monkeypatch
+) -> None:
+    path = tmp_path / "index"
+    index = SchedulerSlotIndex(str(path), 3, _identity())
+    real_pwrite = os.pwrite
+    real_pread = os.pread
+
+    def short_pwrite(fd: int, data, offset: int) -> int:
+        return real_pwrite(fd, data[:3], offset)
+
+    def short_pread(fd: int, size: int, offset: int) -> bytes:
+        return real_pread(fd, min(size, 3), offset)
+
+    monkeypatch.setattr(os, "pwrite", short_pwrite)
+    index.commit({1: b"h" * 36, 2: b"i" * 36})
+    monkeypatch.setattr(os, "pread", short_pread)
+    assert index.load() == {1: b"h" * 36, 2: b"i" * 36}
+
+    def fail_sync(_fd: int) -> None:
+        raise OSError("simulated fdatasync failure")
+
+    monkeypatch.setattr(os, "fdatasync", fail_sync)
+    with pytest.raises(OSError, match="simulated fdatasync failure"):
+        index.invalidate([1])
+    index.close()
+
+
+def test_metadata_size_is_fixed_and_duplicate_hashes_are_bounded(tmp_path) -> None:
+    path = tmp_path / "index"
+    index = SchedulerSlotIndex(str(path), 100, _identity())
+    duplicate = b"d" * 36
+    index.commit({1: duplicate, 99: duplicate})
+    assert index.load() == {1: duplicate, 99: duplicate}
+    index.close()
+    assert path.stat().st_size == 4096 + 100 * 96
