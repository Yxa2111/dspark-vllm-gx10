+    overwritten_slot = meta_b.store_cpu_blocks[0]
+    assert first.scheduler._persistent_index is not None
+    assert overwritten_slot not in first.scheduler._persistent_index.load()
+    first.scheduler._persistent_index.close()
+
+    reopened = make_scheduler(
+        num_cpu_blocks=3,
+        num_gpu_blocks=8,
+        persistent_path=path,
+    )
+    evicted_key = make_block_hash_with_group_id(request_a.block_hashes[0], 0)
+    assert (
+        reopened.scheduler.cpu_block_pool.cached_block_hash_to_block.get_one_block(
