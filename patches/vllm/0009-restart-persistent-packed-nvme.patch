+def test_persistent_scheduler_index_reopens_committed_slots(
+    tmp_path, monkeypatch
+) -> None:
+    monkeypatch.setenv("PYTHONHASHSEED", "0")
+    path = str(tmp_path / "cache")
+    first = make_scheduler(
+        num_cpu_blocks=4,
+        num_gpu_blocks=8,
+        persistent_path=path,
+    )
+    request = make_request(num_blocks=2)
+    blocks = _alloc_and_register(first, request, 2)
+    first.scheduler.update_state_after_alloc(request, blocks, 0)
+    meta = first.scheduler.build_connector_meta(
+        make_scheduler_output(
+            {request.request_id: 2 * BLOCK_SIZE},
+            new_reqs={request.request_id: blocks.get_block_ids()},
+        )
+    )
+    simulate_store_completion(first.scheduler, meta.store_event)
+    assert first.scheduler._persistent_index is not None
+    first.scheduler._persistent_index.close()
+
+    reopened = make_scheduler(
+        num_cpu_blocks=4,
+        num_gpu_blocks=8,
+        persistent_path=path,
+    )
+    restored_blocks = []
+    for block_hash in request.block_hashes[:2]:
+        key = make_block_hash_with_group_id(block_hash, 0)
+        block = (
+            reopened.scheduler.cpu_block_pool.cached_block_hash_to_block.get_one_block(
+                key
+            )
+        )
+        assert block is not None
+        restored_blocks.append(block)
+
+    # The one unused slot must be allocated before either restored slot. The
+    # old restore path left persisted slots at the queue head and evicted one
+    # here despite having empty capacity.
+    allocated = reopened.scheduler.cpu_block_pool.get_new_blocks(1)
+    assert allocated[0].block_id not in {block.block_id for block in restored_blocks}
+    for block_hash in request.block_hashes[:2]:
+        key = make_block_hash_with_group_id(block_hash, 0)
+        assert (
+            reopened.scheduler.cpu_block_pool.cached_block_hash_to_block.get_one_block(
+                key
+            )
+            is not None
+        )
+    assert reopened.scheduler._persistent_index is not None
+    reopened.scheduler._persistent_index.close()
+
+
+def test_persistent_slot_is_invalid_before_worker_overwrite(
+    tmp_path, monkeypatch
+) -> None:
+    monkeypatch.setenv("PYTHONHASHSEED", "0")
+    path = str(tmp_path / "cache")
+    first = make_scheduler(
+        num_cpu_blocks=3,
+        num_gpu_blocks=8,
+        persistent_path=path,
+    )
+    request_a = make_request(num_blocks=2)
+    blocks_a = _alloc_and_register(first, request_a, 2)
+    first.scheduler.update_state_after_alloc(request_a, blocks_a, 0)
+    meta_a = first.scheduler.build_connector_meta(
+        make_scheduler_output(
+            {request_a.request_id: 2 * BLOCK_SIZE},
+            new_reqs={request_a.request_id: blocks_a.get_block_ids()},
+        )
+    )
+    simulate_store_completion(first.scheduler, meta_a.store_event)
+
+    request_b = make_request(num_blocks=1)
+    blocks_b = _alloc_and_register(first, request_b, 1)
+    first.scheduler.update_state_after_alloc(request_b, blocks_b, 0)
+    meta_b = first.scheduler.build_connector_meta(
+        make_scheduler_output(
+            {request_b.request_id: BLOCK_SIZE},
+            new_reqs={request_b.request_id: blocks_b.get_block_ids()},
