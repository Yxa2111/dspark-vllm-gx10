diff --git a/vllm/v1/simple_kv_offload/persistent_metadata.py b/vllm/v1/simple_kv_offload/persistent_metadata.py
new file mode 100644
index 000000000..5771006d1
--- /dev/null
+++ b/vllm/v1/simple_kv_offload/persistent_metadata.py
@@ -0,0 +1,262 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Crash-safe fixed-record metadata for persistent disk KV slots."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import stat
+import struct
+import zlib
+from collections.abc import Iterable, Mapping
+
+_HEADER_SIZE = 4096
+_HEADER_PREFIX = struct.Struct(">8sII32s")
+_MAGIC = b"VKVPM001"
+_VERSION = 1
+_RANK_RECORD = struct.Struct(">B3xII4x")
+_INDEX_HASH_BYTES = 80
+_INDEX_RECORD = struct.Struct(f">BB2x{_INDEX_HASH_BYTES}sI8x")
+
+
+def _pwrite_all(fd: int, data: bytes, offset: int) -> None:
+    view = memoryview(data)
+    written = 0
+    while written < len(view):
+        n = os.pwrite(fd, view[written:], offset + written)
+        if n <= 0:
+            raise OSError("short metadata write")
+        written += n
+
+
+def _pread_exact(fd: int, size: int, offset: int) -> bytes:
+    chunks: list[bytes] = []
+    read = 0
+    while read < size:
+        chunk = os.pread(fd, size - read, offset + read)
+        if not chunk:
+            raise OSError(f"short metadata read: expected={size}, read={read}")
+        chunks.append(chunk)
+        read += len(chunk)
+    return b"".join(chunks)
+
+
+def validate_private_regular_fd(fd: int, path: str) -> os.stat_result:
+    """Reject cache files that can expose or redirect prompt-derived data."""
+    st = os.fstat(fd)
+    if not stat.S_ISREG(st.st_mode):
+        raise ValueError(f"KV cache path is not a regular file: {path}")
+    if st.st_uid != os.geteuid():
+        raise PermissionError(f"KV cache path is not owned by this user: {path}")
+    if stat.S_IMODE(st.st_mode) != 0o600:
+        raise PermissionError(f"KV cache path must have mode 0600: {path}")
+    if st.st_nlink != 1:
+        raise PermissionError(f"KV cache path must not have hard links: {path}")
+    return st
+
+
+def _header_bytes(
+    kind: str,
+    num_slots: int,
+    record_size: int,
+    identity: Mapping[str, object],
+) -> bytes:
+    document = {
+        "identity": dict(identity),
+        "kind": kind,
+        "num_slots": num_slots,
+        "record_size": record_size,
+        "version": _VERSION,
+    }
+    payload = json.dumps(
+        document,
+        ensure_ascii=True,
+        separators=(",", ":"),
+        sort_keys=True,
+    ).encode("ascii")
+    if len(payload) > _HEADER_SIZE - _HEADER_PREFIX.size:
+        raise ValueError("persistent KV identity is too large")
+    digest = hashlib.sha256(payload).digest()
+    prefix = _HEADER_PREFIX.pack(_MAGIC, _VERSION, len(payload), digest)
+    return (prefix + payload).ljust(_HEADER_SIZE, b"\0")
+
+
+class _FixedRecordFile:
+    def __init__(
+        self,
+        path: str,
+        kind: str,
+        num_slots: int,
+        record_size: int,
+        identity: Mapping[str, object],
+    ) -> None:
+        if num_slots < 1:
+            raise ValueError("persistent KV metadata requires at least one slot")
+        flags = os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW
+        flags |= getattr(os, "O_CLOEXEC", 0)
+        fd = os.open(path, flags, 0o600)
+        try:
+            st = validate_private_regular_fd(fd, path)
+            expected_header = _header_bytes(kind, num_slots, record_size, identity)
+            expected_size = _HEADER_SIZE + num_slots * record_size
+            if st.st_size == 0:
+                os.ftruncate(fd, expected_size)
+                _pwrite_all(fd, expected_header, 0)
+                os.fdatasync(fd)
+            elif st.st_size != expected_size:
+                raise ValueError(
+                    f"persistent KV metadata size mismatch for {path}: "
+                    f"expected={expected_size}, actual={st.st_size}"
+                )
+            elif _pread_exact(fd, _HEADER_SIZE, 0) != expected_header:
+                raise ValueError(f"persistent KV metadata identity mismatch for {path}")
+        except BaseException:
+            os.close(fd)
+            raise
+        self.path = path
+        self.num_slots = num_slots
+        self.record_size = record_size
+        self.fd = fd
+
+    def _offset(self, slot: int) -> int:
+        if not 0 <= slot < self.num_slots:
+            raise IndexError(f"persistent KV slot out of range: {slot}")
+        return _HEADER_SIZE + slot * self.record_size
+
+    def invalidate(self, slots: Iterable[int]) -> None:
+        changed = False
+        empty = b"\0" * self.record_size
+        for slot in dict.fromkeys(slots):
+            _pwrite_all(self.fd, empty, self._offset(slot))
+            changed = True
+        if changed:
+            os.fdatasync(self.fd)
+
+    def clear(self) -> None:
+        """Durably invalidate every slot in the metadata file."""
+        empty = b"\0" * (self.num_slots * self.record_size)
+        _pwrite_all(self.fd, empty, _HEADER_SIZE)
+        os.fdatasync(self.fd)
+
+    def _records(self) -> bytes:
+        return _pread_exact(
+            self.fd,
+            self.num_slots * self.record_size,
+            _HEADER_SIZE,
+        )
+
+    def close(self) -> None:
+        if self.fd >= 0:
+            os.close(self.fd)
+            self.fd = -1
+
+
+def _record_crc(slot: int, body: bytes) -> int:
+    return zlib.crc32(slot.to_bytes(8, "big") + body)
+
+
+class RankSlotManifest(_FixedRecordFile):
+    """Durable per-rank checksum and validity records."""
+
+    def __init__(
+        self,
+        path: str,
+        num_slots: int,
+        identity: Mapping[str, object],
+    ) -> None:
+        super().__init__(
+            path,
+            "rank-manifest",
+            num_slots,
+            _RANK_RECORD.size,
+            identity,
+        )
+
+    def commit(self, checksums: Mapping[int, int]) -> None:
+        for slot, checksum in checksums.items():
+            if not 0 <= checksum <= 0xFFFFFFFF:
+                raise ValueError(f"invalid CRC32 for slot {slot}: {checksum}")
+            body = struct.pack(">B3xI", 1, checksum)
+            record = _RANK_RECORD.pack(
+                1,
+                checksum,
+                _record_crc(slot, body),
+            )
+            _pwrite_all(self.fd, record, self._offset(slot))
+        if checksums:
+            os.fdatasync(self.fd)
+
+    def load(self) -> list[int | None]:
+        raw = self._records()
+        checksums: list[int | None] = [None] * self.num_slots
+        empty = b"\0" * self.record_size
+        for slot in range(self.num_slots):
+            start = slot * self.record_size
+            record = raw[start : start + self.record_size]
+            if record == empty:
+                continue
+            state, checksum, expected_crc = _RANK_RECORD.unpack(record)
+            body = struct.pack(">B3xI", state, checksum)
+            if state != 1 or _record_crc(slot, body) != expected_crc:
+                raise ValueError(f"corrupt persistent rank record at slot {slot}")
+            checksums[slot] = checksum
+        return checksums
+
+
+class SchedulerSlotIndex(_FixedRecordFile):
+    """Durable scheduler authority for committed hash-to-slot mappings."""
+
+    def __init__(
+        self,
+        path: str,
+        num_slots: int,
+        identity: Mapping[str, object],
+    ) -> None:
+        super().__init__(
+            path,
+            "scheduler-index",
+            num_slots,
+            _INDEX_RECORD.size,
+            identity,
+        )
+
+    def commit(self, mappings: Mapping[int, bytes]) -> None:
+        for slot, block_hash in mappings.items():
+            if not block_hash or len(block_hash) > _INDEX_HASH_BYTES:
+                raise ValueError(
+                    f"invalid persistent block hash length at slot {slot}: "
+                    f"{len(block_hash)}"
+                )
+            padded = block_hash.ljust(_INDEX_HASH_BYTES, b"\0")
+            body = struct.pack(">BB2x", 1, len(block_hash)) + padded
+            record = _INDEX_RECORD.pack(
+                1,
+                len(block_hash),
+                padded,
+                _record_crc(slot, body),
+            )
+            _pwrite_all(self.fd, record, self._offset(slot))
+        if mappings:
+            os.fdatasync(self.fd)
+
+    def load(self) -> dict[int, bytes]:
+        raw = self._records()
+        mappings: dict[int, bytes] = {}
+        empty = b"\0" * self.record_size
+        for slot in range(self.num_slots):
+            start = slot * self.record_size
+            record = raw[start : start + self.record_size]
+            if record == empty:
+                continue
+            state, length, padded, expected_crc = _INDEX_RECORD.unpack(record)
+            body = struct.pack(">BB2x", state, length) + padded
+            if (
+                state != 1
+                or not 0 < length <= _INDEX_HASH_BYTES
+                or _record_crc(slot, body) != expected_crc
+            ):
+                raise ValueError(f"corrupt persistent scheduler record at slot {slot}")
+            mappings[slot] = padded[:length]
+        return mappings
