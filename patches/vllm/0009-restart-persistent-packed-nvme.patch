+def test_persistent_backend_reopens_data_and_checksums(tmp_path, monkeypatch) -> None:
+    monkeypatch.setattr(disk_backend_module, "pin_tensor", lambda _tensor: None)
+    monkeypatch.setattr(
+        disk_backend_module,
+        "current_platform",
+        SimpleNamespace(set_device=lambda _device: None),
+    )
+    monkeypatch.setattr(
+        disk_backend_module,
+        "build_params",
+        lambda *_args, **_kwargs: object(),
+    )
+    path = tmp_path / "persistent.slots"
+    identity = {
+        "cache_identity": "backend-unit-test",
+        "payload_bytes": 4096,
+        "rank": 0,
+        "slot_bytes": 4096,
+        "world_size": 2,
+    }
+
+    first = DiskBackend()
+    first.init(
+        {"kv": torch.zeros((2, 4096), dtype=torch.int8)},
+        torch.device("cpu"),
+        SimpleNamespace(cuda_stream=1),
+        SimpleNamespace(cuda_stream=2),
+        str(path),
+        num_disk_slots=2,
+        total_block_bytes=4096,
+        use_page_cache=True,
+        preallocate_disk=False,
+        persistent=True,
+        persistent_identity=identity,
+    )
+    first._store_raw[0].copy_(
+        torch.arange(4096, dtype=torch.int64).remainder(251).to(torch.int8)
+    )
+    expected = first._store_raw[0].clone()
+    first._writev_slot(0, 1)
+    os.fdatasync(first._fd)
+    assert first._manifest is not None
+    checksum = first._slot_checksums[1]
+    assert checksum is not None
+    first._manifest.commit({1: checksum})
+    first.shutdown()
+
+    assert path.exists()
+    assert (tmp_path / "persistent.slots.meta").exists()
+    second = DiskBackend()
+    second.init(
+        {"kv": torch.zeros((2, 4096), dtype=torch.int8)},
+        torch.device("cpu"),
+        SimpleNamespace(cuda_stream=1),
+        SimpleNamespace(cuda_stream=2),
+        str(path),
+        num_disk_slots=2,
+        total_block_bytes=4096,
+        use_page_cache=True,
+        preallocate_disk=False,
+        persistent=True,
+        persistent_identity=identity,
+    )
+    try:
+        second._readv_slot(0, 1)
+        assert torch.equal(second._load_raw[0], expected)
+        os.pwrite(second._fd, b"corrupt", 17 + 4096)
+        with pytest.raises(OSError, match="checksum mismatch"):
+            second._readv_slot(0, 1)
+    finally:
+        second.shutdown()
+
