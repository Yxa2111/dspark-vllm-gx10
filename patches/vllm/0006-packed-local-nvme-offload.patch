+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU-only production guards for the local NVMe offload backend."""
+
+from __future__ import annotations
+
+import os
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm.v1.simple_kv_offload import cuda_mem_ops
+from vllm.v1.simple_kv_offload.disk_backend import (
+    DiskBackend,
+    _alloc_aligned,
+    aligned_disk_slot_bytes,
+)
+
+
+def test_packed_dspark_block_gets_legal_direct_io_geometry() -> None:
+    payload = 1_065_792
+    slot = aligned_disk_slot_bytes(payload)
+
+    assert slot == 1_069_056
+    assert slot % 4096 == 0
+    assert slot - payload == 3264
+
+
+def test_aligned_rows_and_payload_views_keep_padding_isolated() -> None:
+    backend = DiskBackend()
+    backend._disk_slot_bytes = 8192
+    backend._total_block_bytes = 5000
+    backend._tensor_names = ["mla", "indexer"]
+    backend._per_tensor_bpb = [4000, 1000]
+    raw = _alloc_aligned(2, backend._disk_slot_bytes)
+    raw.fill_(-1)
+
+    views = backend._build_payload_views(raw)
+
+    assert raw.data_ptr() % 4096 == 0
+    assert raw[1].data_ptr() % 4096 == 0
+    assert views["mla"].stride(0) == backend._disk_slot_bytes
+    assert views["indexer"].stride(0) == backend._disk_slot_bytes
+    assert views["mla"].data_ptr() == raw.data_ptr()
+    assert views["indexer"].data_ptr() == raw.data_ptr() + 4000
+
+    views["mla"][0].fill_(11)
+    views["indexer"][0].fill_(22)
+    assert torch.all(raw[0, :4000] == 11)
+    assert torch.all(raw[0, 4000:5000] == 22)
+    assert torch.all(raw[0, 5000:] == -1)
+    assert torch.all(raw[1] == -1)
+
+
+def test_disk_roundtrip_and_checksum_failure(tmp_path) -> None:
+    backend = DiskBackend()
+    backend._disk_slot_bytes = 8192
+    backend._slot_checksums = [None, None]
+    backend._store_raw = _alloc_aligned(1, backend._disk_slot_bytes)
+    backend._load_raw = _alloc_aligned(1, backend._disk_slot_bytes)
+    backend._store_slot_views = [[memoryview(backend._store_raw[0].numpy())]]
+    backend._load_slot_views = [[memoryview(backend._load_raw[0].numpy())]]
+
+    path = tmp_path / "kv.slots"
+    backend._fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_EXCL, 0o600)
+    os.ftruncate(backend._fd, 2 * backend._disk_slot_bytes)
+    try:
+        backend._store_raw[0].copy_(
+            torch.arange(backend._disk_slot_bytes, dtype=torch.int64)
+            .remainder(251)
+            .to(torch.int8)
+        )
+        expected = backend._store_raw.clone()
+        backend._writev_slot(0, 1)
+        backend._load_raw.zero_()
+        backend._readv_slot(0, 1)
+        assert torch.equal(backend._load_raw, expected)
+
+        os.pwrite(backend._fd, b"corrupt", backend._disk_slot_bytes + 17)
+        with pytest.raises(OSError, match="checksum mismatch"):
+            backend._readv_slot(0, 1)
+    finally:
+        os.close(backend._fd)
+        backend._fd = -1
+
+
+def test_background_failure_is_raised_on_engine_thread() -> None:
+    backend = DiskBackend()
+    try:
+        raise OSError("simulated ENOSPC")
+    except OSError as error:
+        backend._record_failure("store", 41, error)
+
+    with pytest.raises(RuntimeError, match="store event 41.*simulated ENOSPC"):
+        backend.raise_if_failed()
+
+
+def test_batch_copy_uses_independent_row_strides(monkeypatch) -> None:
+    monkeypatch.setattr(cuda_mem_ops, "_batch_memcpy_fn", object())
+    src = {"kv": torch.zeros((2, 3), dtype=torch.int8)}
+    backing = torch.zeros(10, dtype=torch.int8)
+    dst = {
+        "kv": torch.as_strided(
+            backing,
+            size=(2, 3),
+            stride=(5, 1),
+        )
+    }
+
+    params = cuda_mem_ops.build_params(
+        src,
+        dst,
+        SimpleNamespace(cuda_stream=7),
+    )
+
+    assert params.src_strides.tolist() == [3]
+    assert params.dst_strides.tolist() == [5]
+    assert params.copy_sizes.tolist() == [3]
