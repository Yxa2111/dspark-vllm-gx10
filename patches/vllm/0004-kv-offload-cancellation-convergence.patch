+    def cancel_jobs(self, job_ids: Collection[JobId]) -> set[JobId]:
+        """Cancel queued tasks while preserving one completion per job.
+
+        Tasks already removed by a worker are not interrupted. Removed tasks
+        are accounted as failures in their shared ``JobState``; once all active
+        and cancelled tasks converge, the ordinary finished queue reports the
+        failed job and releases the pool's in-flight count.
+        """
+        selected = set(job_ids)
+        if not selected:
+            return set()
+
+        cancelled: set[JobId] = set()
+        with self._condition:
+            for queue in (self._load_q, self._store_q):
+                retained = deque()
+                while queue:
+                    task, state = queue.popleft()
+                    if state.job_id not in selected:
+                        retained.append((task, state))
+                        continue
+
+                    cancelled.add(state.job_id)
+                    job_finished, success = state.task_done(False)
+                    if job_finished:
+                        self._finished_q.append((state.job_id, success))
+                        self._inflight_jobs -= 1
+                queue.extend(retained)
+            if cancelled:
+                self._condition.notify_all()
+        return cancelled
+
