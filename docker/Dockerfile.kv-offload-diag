# SPDX-License-Identifier: MIT
ARG VLLM_BASE=ghcr.io/anemll/dspark-vllm-gx10:0.1.1@sha256:a83948492cf13df455170fb42885f5ef4db54fefe0feff0f841ecbff464ac9d8
FROM ${VLLM_BASE}

LABEL org.opencontainers.image.source="https://github.com/Yxa2111/dspark-vllm-gx10"
LABEL org.opencontainers.image.description="Phase 0 packed-KV offload diagnostics"

COPY overlay/vllm/v1/kv_offload/diag.py \
  /usr/local/lib/python3.12/dist-packages/vllm/v1/kv_offload/diag.py
COPY patches/vllm/0001-kv-offload-layout-diag.patch /tmp/kv-offload-layout-diag.patch

RUN cd /usr/local/lib/python3.12/dist-packages && \
    patch --batch --forward --dry-run -p1 < /tmp/kv-offload-layout-diag.patch && \
    patch --batch --forward -p1 < /tmp/kv-offload-layout-diag.patch && \
    python3 -m py_compile \
      vllm/v1/kv_offload/diag.py \
      vllm/v1/kv_offload/cpu/spec.py \
      vllm/v1/kv_offload/file_mapper.py \
      vllm/distributed/kv_transfer/kv_connector/v1/offloading/worker.py && \
    rm -f /tmp/kv-offload-layout-diag.patch
