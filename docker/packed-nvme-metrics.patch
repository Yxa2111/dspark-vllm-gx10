+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Prometheus metrics for the bounded local-NVMe offload backend."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any
+
+from vllm.config import VllmConfig
+from vllm.distributed.kv_transfer.kv_connector.v1.metrics import (
+    KVConnectorPromMetrics,
+    KVConnectorStats,
+    PromMetric,
+    PromMetricT,
+)
+
+DISK_CAPACITY_BYTES = "vllm:kv_offload_disk_capacity_bytes"
+DISK_CAPACITY_SLOTS = "vllm:kv_offload_disk_capacity_slots"
+DISK_COMMITTED_SLOTS = "vllm:kv_offload_disk_committed_slots"
+DISK_RESTORED_SLOTS = "vllm:kv_offload_disk_restored_slots"
+DISK_STAGING_BYTES = "vllm:kv_offload_disk_staging_bytes"
+DISK_BUFFER_SLOTS = "vllm:kv_offload_disk_buffer_slots"
+DISK_QUEUE_DEPTH = "vllm:kv_offload_disk_queue_depth"
+DISK_INFLIGHT_BLOCKS = "vllm:kv_offload_disk_inflight_blocks"
+DISK_TRANSFER_BYTES = "vllm:kv_offload_disk_transfer_bytes"
+DISK_TRANSFER_BLOCKS = "vllm:kv_offload_disk_transfer_blocks"
+DISK_TRANSFER_OPERATIONS = "vllm:kv_offload_disk_transfer_operations"
+DISK_TRANSFER_DURATION = "vllm:kv_offload_disk_transfer_duration_seconds"
+DISK_EVICTIONS = "vllm:kv_offload_disk_evictions"
+DISK_ERRORS = "vllm:kv_offload_disk_errors"
+
+_COUNTERS = "counters"
+_GAUGES = "gauges"
+_HISTOGRAMS = "histograms"
+
+
+@dataclass(frozen=True)
+class _MetricDefinition:
+    kind: str
+    documentation: str
+    labelnames: tuple[str, ...] = ()
+    buckets: tuple[float, ...] | None = None
+
+
+_METRIC_DEFINITIONS = {
+    DISK_CAPACITY_BYTES: _MetricDefinition(
+        _GAUGES,
+        "Configured or allocated NVMe KV cache capacity, in bytes.",
+        ("scope",),
+    ),
+    DISK_CAPACITY_SLOTS: _MetricDefinition(
+        _GAUGES,
+        "Number of fixed-size NVMe KV cache slots.",
+        ("scope",),
+    ),
+    DISK_COMMITTED_SLOTS: _MetricDefinition(
+        _GAUGES,
+        "Number of committed or rank-valid NVMe KV cache slots.",
+        ("scope",),
+    ),
+    DISK_RESTORED_SLOTS: _MetricDefinition(
+        _GAUGES,
+        "Number of persistent NVMe KV slots restored at process startup.",
+        ("scope",),
+    ),
+    DISK_STAGING_BYTES: _MetricDefinition(
+        _GAUGES,
+        "Pinned host staging capacity for one transfer direction, in bytes.",
+        ("rank", "operation"),
+    ),
+    DISK_BUFFER_SLOTS: _MetricDefinition(
+        _GAUGES,
+        "Number of reusable pinned staging rows for one transfer direction.",
+        ("rank", "operation"),
+    ),
+    DISK_QUEUE_DEPTH: _MetricDefinition(
+        _GAUGES,
+        "Current number of queued NVMe KV transfer events.",
+        ("rank", "operation"),
+    ),
+    DISK_INFLIGHT_BLOCKS: _MetricDefinition(
+        _GAUGES,
+        "Current number of NVMe KV blocks in the executing transfer event.",
+        ("rank", "operation"),
+    ),
+    DISK_TRANSFER_BYTES: _MetricDefinition(
+        _COUNTERS,
+        "Total aligned bytes successfully transferred through the NVMe backend.",
+        ("rank", "operation"),
+    ),
+    DISK_TRANSFER_BLOCKS: _MetricDefinition(
+        _COUNTERS,
+        "Total fixed-size blocks successfully transferred through NVMe.",
+        ("rank", "operation"),
+    ),
+    DISK_TRANSFER_OPERATIONS: _MetricDefinition(
+        _COUNTERS,
+        "Total successful NVMe KV transfer events.",
+        ("rank", "operation"),
+    ),
+    DISK_TRANSFER_DURATION: _MetricDefinition(
+        _HISTOGRAMS,
+        "NVMe KV backend event time through final CUDA DMA submission.",
+        ("rank", "operation"),
+        (
+            0.001,
+            0.005,
+            0.01,
+            0.025,
+            0.05,
+            0.1,
+            0.25,
+            0.5,
+            1.0,
+            2.5,
+            5.0,
+            10.0,
+            30.0,
+            60.0,
+            120.0,
+            300.0,
+        ),
+    ),
+    DISK_EVICTIONS: _MetricDefinition(
+        _COUNTERS,
+        "Total committed NVMe KV slots evicted for reuse.",
+    ),
+    DISK_ERRORS: _MetricDefinition(
+        _COUNTERS,
+        "Total NVMe KV backend errors by bounded reason.",
+        ("rank", "operation", "reason"),
+    ),
+}
+
+
+@dataclass
+class SimpleCPUOffloadStats(KVConnectorStats):
+    """Serializable interval counters, gauges, and histogram samples."""
+
+    def __post_init__(self) -> None:
+        if not self.data:
+            self.reset()
+
+    def reset(self) -> None:
+        self.data = {
+            _COUNTERS: {},
+            _GAUGES: {},
+            _HISTOGRAMS: {},
+        }
+
+    def increase_counter(
+        self,
+        name: str,
+        value: int | float,
+        labelvalues: tuple[str, ...] = (),
+    ) -> None:
+        values = self.data[_COUNTERS].setdefault(name, {})
+        values[labelvalues] = values.get(labelvalues, 0) + value
+
+    def set_gauge(
+        self,
+        name: str,
+        value: int | float,
+        labelvalues: tuple[str, ...] = (),
+    ) -> None:
+        self.data[_GAUGES].setdefault(name, {})[labelvalues] = value
+
+    def observe_histogram(
+        self,
+        name: str,
+        value: int | float,
+        labelvalues: tuple[str, ...] = (),
+    ) -> None:
+        self.data[_HISTOGRAMS].setdefault(name, {}).setdefault(labelvalues, []).append(
+            value
+        )
+
+    def aggregate(self, other: KVConnectorStats) -> KVConnectorStats:
+        assert isinstance(other, SimpleCPUOffloadStats)
+        for name, labeled_values in other.data[_COUNTERS].items():
+            for labelvalues, value in labeled_values.items():
+                self.increase_counter(name, value, labelvalues)
+        for name, labeled_values in other.data[_GAUGES].items():
+            for labelvalues, value in labeled_values.items():
+                self.set_gauge(name, value, labelvalues)
+        for name, labeled_values in other.data[_HISTOGRAMS].items():
+            for labelvalues, samples in labeled_values.items():
+                for sample in samples:
+                    self.observe_histogram(name, sample, labelvalues)
+        return self
+
+    def reduce(self) -> dict[str, int | float]:
+        reduced: dict[str, int | float] = {}
+        for kind in (_COUNTERS, _GAUGES):
+            for name, labeled_values in self.data[kind].items():
+                for labelvalues, value in labeled_values.items():
+                    key = f"{name}:{labelvalues}" if labelvalues else name
+                    reduced[key] = value
+        for name, labeled_values in self.data[_HISTOGRAMS].items():
+            for labelvalues, samples in labeled_values.items():
+                key = f"{name}:{labelvalues}" if labelvalues else name
+                reduced[f"{key}_count"] = len(samples)
+                reduced[f"{key}_sum"] = sum(samples)
+        return reduced
+
+    def is_empty(self) -> bool:
+        return not any(self.data[kind] for kind in self.data)
+
+
+class SimpleCPUOffloadPromMetrics(KVConnectorPromMetrics):
+    """Registers and observes bounded local-NVMe connector metrics."""
+
+    def __init__(
+        self,
+        vllm_config: VllmConfig,
+        metric_types: dict[type[PromMetric], type[PromMetricT]],
+        labelnames: list[str],
+        per_engine_labelvalues: dict[int, list[object]],
+    ) -> None:
+        super().__init__(vllm_config, metric_types, labelnames, per_engine_labelvalues)
+        self.metric_definitions: dict[str, PromMetricT] = {}
+        self.metrics: dict[tuple[int, str, tuple[str, ...]], PromMetricT] = {}
+        metric_classes = {
+            _COUNTERS: self._counter_cls,
+            _GAUGES: self._gauge_cls,
+            _HISTOGRAMS: self._histogram_cls,
+        }
+        for name, definition in _METRIC_DEFINITIONS.items():
+            kwargs: dict[str, Any] = {
+                "name": name,
+                "documentation": definition.documentation,
+                "labelnames": labelnames + list(definition.labelnames),
+            }
+            if definition.buckets is not None:
+                kwargs["buckets"] = definition.buckets
+            self.metric_definitions[name] = metric_classes[definition.kind](**kwargs)
+
+    def _metric(
+        self,
+        engine_idx: int,
+        name: str,
+        labelvalues: tuple[str, ...],
+    ) -> PromMetricT:
+        definition = _METRIC_DEFINITIONS[name]
+        if len(labelvalues) != len(definition.labelnames):
+            raise AssertionError(
+                f"Metric {name} expects {len(definition.labelnames)} labels, "
+                f"got {len(labelvalues)}"
+            )
+        key = (engine_idx, name, labelvalues)
+        metric = self.metrics.get(key)
+        if metric is None:
+            engine_labels = self.per_engine_labelvalues[engine_idx]
+            metric = self.metric_definitions[name].labels(
+                *(engine_labels + list(labelvalues))
+            )
+            self.metrics[key] = metric
+        return metric
+
+    def observe(self, transfer_stats_data: dict[str, Any], engine_idx: int = 0) -> None:
+        stats = SimpleCPUOffloadStats(data=transfer_stats_data)
+        for name, labeled_values in stats.data[_COUNTERS].items():
+            assert _METRIC_DEFINITIONS[name].kind == _COUNTERS
+            for labelvalues, value in labeled_values.items():
+                self._metric(engine_idx, name, labelvalues).inc(value)
+        for name, labeled_values in stats.data[_GAUGES].items():
+            assert _METRIC_DEFINITIONS[name].kind == _GAUGES
+            for labelvalues, value in labeled_values.items():
+                self._metric(engine_idx, name, labelvalues).set(value)
+        for name, labeled_values in stats.data[_HISTOGRAMS].items():
+            assert _METRIC_DEFINITIONS[name].kind == _HISTOGRAMS
+            for labelvalues, samples in labeled_values.items():
+                metric = self._metric(engine_idx, name, labelvalues)
+                for sample in samples:
+                    metric.observe(sample)
